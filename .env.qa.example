# Entorno QA local: versión compilada para probar antes de publicar en producción.
# `npm run qa:deploy` copia este archivo como .env.qa si no existe.

# ─── Base de datos (mismo PostgreSQL de Docker, BD separada) ─────
# Por seguridad, el nombre de la BD debe terminar en _qa.
DATABASE_URL="postgresql://reportes:reportes@localhost:5434/reportes_qa?schema=public"

# ─── Aplicación ──────────────────────────────────────────────────
# Franja de color y prefijo en el título para distinguir el entorno (no se define en producción).
APP_ENV="qa"
APP_URL="http://localhost:3300"
# Cookie de sesión distinta a la de desarrollo: así se puede tener abierta
# una sesión en localhost:3100 y otra en localhost:3300 al mismo tiempo.
SESSION_COOKIE_SUFFIX="-qa"

# ─── Almacenamiento de fotos ─────────────────────────────────────
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage-qa"

# ─── Datos semilla (solo la primera vez, si la BD de QA está vacía) ─
SEED_PASSWORD="Cambiar.2026"
