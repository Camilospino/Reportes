// Modelo de datos de Reportes de Daños.
// Convención: modelos/campos en camelCase (TypeScript), tablas/columnas en snake_case (SQL).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECNICO
}

/// El orden importa: se usa en la máquina de estados y en los filtros.
enum ReportStatus {
  PENDIENTE
  EN_PROCESO
  REALIZADO
  APLAZADO
  CLIENTE_AUSENTE
  VERIFICADO
  CANCELADO
}

/// Tipos de daño de un proveedor de internet.
enum DamageCategory {
  SIN_SERVICIO
  LENTITUD
  FIBRA_CABLEADO
  EQUIPO
  WIFI
  OTRO
}

/// El orden importa: ordenar ascendente pone ALTA primero.
enum Priority {
  ALTA
  MEDIA
  BAJA
}

/// Tipo de orden. Los tres comparten estados, flujo y consecutivo (R-000001).
enum OrderType {
  DANO
  INSTALACION
  RETIRO
}

enum EquipmentAction {
  INSTALAR
  RETIRAR
}

/// Estado del equipo recogido en un retiro.
enum EquipmentCondition {
  BUENO
  DANADO
  INCOMPLETO
}

enum WithdrawalReason {
  CANCELACION
  CAMBIO_EQUIPO
  MORA
  OTRO
}

/// Umbrales del plazo que generan aviso (los nombres son los de la configuración por defecto: 24 h, 48 h, 72 h).
enum DeadlineThreshold {
  H24
  H48
  VENCIDO
}

enum AttachmentKind {
  EVIDENCIA
  FACHADA
}

enum AuditEntity {
  REPORT
  USER
  AUTH
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(120)
  /// Siempre en minúsculas.
  username           String   @unique @db.VarChar(50)
  passwordHash       String   @map("password_hash")
  role               Role
  phone              String?  @db.VarChar(20)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  assignedReports Report[]       @relation("AssignedReports")
  createdReports  Report[]       @relation("CreatedReports")
  attachments     Attachment[]
  auditEntries    AuditLog[]     @relation("AuditActor")
  auditAsTarget   AuditLog[]     @relation("AuditTargetUser")
  notifications   Notification[]

  @@map("users")
}

model Session {
  /// SHA-256 del token de la cookie (el token en claro nunca se guarda).
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  ip        String?  @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Report {
  id                    String            @id @default(uuid()) @db.Uuid
  /// Consecutivo legible, se muestra como R-000123.
  code                  Int               @unique @default(autoincrement())
  type                  OrderType         @default(DANO)
  street                String            @db.VarChar(200)
  neighborhood          String            @db.VarChar(120)
  city                  String            @db.VarChar(120)
  referencePoint        String?           @map("reference_point") @db.VarChar(200)
  /// Solo en daños (NULL en instalaciones y retiros).
  category              DamageCategory?
  /// Daño: descripción (obligatoria). Instalación y retiro: observaciones (puede quedar vacía).
  description           String            @db.VarChar(2000)
  /// Instalación: plan o velocidad contratada ("300 Mbps").
  plan                  String?           @db.VarChar(60)
  /// Instalación: fecha sugerida para la visita.
  suggestedDate         DateTime?         @map("suggested_date") @db.Date
  /// Retiro: motivo, y el texto libre cuando es OTRO.
  withdrawalReason      WithdrawalReason? @map("withdrawal_reason")
  withdrawalReasonOther String?           @map("withdrawal_reason_other") @db.VarChar(200)
  priority              Priority
  clientName            String            @map("client_name") @db.VarChar(120)
  clientPhone           String            @map("client_phone") @db.VarChar(20)
  /// Número de contrato del cliente con la empresa de internet (en mayúsculas).
  /// NULL solo en reportes creados antes de existir el campo.
  contractNumber        String?           @map("contract_number") @db.VarChar(30)
  status                ReportStatus      @default(PENDIENTE)
  assignedToId          String?           @map("assigned_to_id") @db.Uuid
  createdById           String            @map("created_by_id") @db.Uuid
  /// Nueva fecha estimada indicada por el técnico al aplazar.
  rescheduledFor        DateTime?         @map("rescheduled_for") @db.Date
  /// Dirección normalizada (minúsculas, sin tildes) para la búsqueda.
  searchText            String            @map("search_text") @db.VarChar(700)
  /// Control de concurrencia optimista: se incrementa en cada cambio.
  version               Int               @default(0)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt              DateTime?         @map("closed_at") @db.Timestamptz(3)
  /// Cuándo pasó a En proceso. Se borra si vuelve a Pendiente.
  startedAt             DateTime?         @map("started_at") @db.Timestamptz(3)
  /// Cuándo el técnico lo marcó Realizado ("Hechos hoy"). Se conserva al verificar y se borra si se reabre.
  completedAt           DateTime?         @map("completed_at") @db.Timestamptz(3)
  /// Plazo: creadoEn + horas del plazo de su tipo al crearla. No cambia si el admin la devuelve.
  dueAt                 DateTime          @map("due_at") @db.Timestamptz(3)
  /// Desde cuántas horas se avisa ("Atención"), copiado de la configuración al crear.
  warnFromHours         Int               @default(24) @map("warn_from_hours")
  /// completedAt <= dueAt. Se calcula al marcar Realizado y se borra si se reabre.
  metDeadline           Boolean?          @map("met_deadline")

  assignedTo    User?             @relation("AssignedReports", fields: [assignedToId], references: [id])
  createdBy     User              @relation("CreatedReports", fields: [createdById], references: [id])
  attachments   Attachment[]
  auditLog      AuditLog[]
  equipment     ReportEquipment[]
  notifications Notification[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([assignedToId, completedAt])
  @@index([priority])
  @@index([createdAt])
  @@index([type])
  @@index([status, dueAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "reports_search_text_trgm_idx")
  @@map("reports")
}

model Attachment {
  id           String         @id @default(uuid()) @db.Uuid
  reportId     String         @map("report_id") @db.Uuid
  /// Evento de bitácora al que quedó vinculada. NULL = subida pero aún no enviada.
  auditLogId   BigInt?        @map("audit_log_id")
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  kind         AttachmentKind
  storageKey   String         @unique @map("storage_key") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(50)
  sizeBytes    Int            @map("size_bytes")
  width        Int
  height       Int
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  report     Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  auditLog   AuditLog? @relation(fields: [auditLogId], references: [id])
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([reportId])
  @@index([auditLogId])
  @@map("attachments")
}

/// Bitácora de auditoría (solo inserciones). También es el historial de cada reporte.
model AuditLog {
  id           BigInt        @id @default(autoincrement())
  actorId      String?       @map("actor_id") @db.Uuid
  entity       AuditEntity
  reportId     String?       @map("report_id") @db.Uuid
  targetUserId String?       @map("target_user_id") @db.Uuid
  /// Ej.: CREAR, EDITAR, TOMAR, REALIZADO, VERIFICAR, LOGIN_OK... (ver src/domain/labels.ts)
  action       String        @db.VarChar(40)
  fromStatus   ReportStatus? @map("from_status")
  toStatus     ReportStatus? @map("to_status")
  /// Datos adicionales: motivo, nota, fecha del intento, cambios de campos (antes/después).
  data         Json?
  comment      String?       @db.VarChar(1000)
  ip           String?       @db.VarChar(64)
  /// Idempotencia: un reintento con el mismo requestId no duplica el cambio.
  requestId    String?       @unique @map("request_id") @db.VarChar(64)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  actor       User?        @relation("AuditActor", fields: [actorId], references: [id])
  report      Report?      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  targetUser  User?        @relation("AuditTargetUser", fields: [targetUserId], references: [id])
  attachments Attachment[]

  @@index([reportId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

/// Equipos de una instalación (a instalar) o de un retiro (a recoger).
model ReportEquipment {
  id          String              @id @default(uuid()) @db.Uuid
  reportId    String              @map("report_id") @db.Uuid
  /// Texto libre con sugerencias: Router, ONU, Decodificador, Antena, Otro.
  kind        String              @db.VarChar(40)
  /// Puede faltar al crear; en instalaciones es obligatorio al cerrar.
  serial      String?             @db.VarChar(80)
  action      EquipmentAction
  /// Solo retiros: si el técnico lo recibió.
  received    Boolean?
  /// Solo retiros: estado en que se recibió.
  condition   EquipmentCondition?
  observation String?             @db.VarChar(300)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_equipment")
}

/// Plazo por tipo de orden (editable en Ajustes → Plazos). Solo afecta a las órdenes nuevas.
model DeadlineConfig {
  type          OrderType @id
  deadlineHours Int       @default(72) @map("deadline_hours")
  warnFromHours Int       @default(24) @map("warn_from_hours")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("deadline_config")
}

/// Aviso dentro de la app. Nunca se repite el mismo umbral de la misma orden para el mismo usuario.
model Notification {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  reportId  String            @map("report_id") @db.Uuid
  threshold DeadlineThreshold
  message   String            @db.VarChar(300)
  read      Boolean           @default(false)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId, threshold])
  @@index([userId, read, createdAt])
  @@index([reportId])
  @@map("notifications")
}

/// Última ejecución de tareas periódicas (p. ej. la revisión de plazos), para no repetirlas seguido.
model JobRun {
  name      String   @id @db.VarChar(40)
  lastRunAt DateTime @map("last_run_at") @db.Timestamptz(3)

  @@map("job_runs")
}
