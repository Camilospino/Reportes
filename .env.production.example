# Copie este archivo como .env en el servidor y complete los valores.
# ─── Dominio y app ───────────────────────────────────────────────
DOMAIN=reportes.suempresa.com
APP_URL=https://reportes.suempresa.com

# ─── PostgreSQL (contraseña larga y aleatoria: openssl rand -base64 32) ───
POSTGRES_USER=reportes
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=reportes

# ─── Fotos en Cloudflare R2 (bucket PRIVADO) ─────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=reportes-fotos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Respaldos (bucket R2 separado, también privado) ─────────────
BACKUP_S3_BUCKET=reportes-respaldos
