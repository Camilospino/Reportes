# ─── Base de datos ───────────────────────────────────────────────
# Desarrollo (docker-compose.dev.yml expone Postgres en 5434)
DATABASE_URL="postgresql://reportes:reportes@localhost:5434/reportes?schema=public"

# ─── Aplicación ──────────────────────────────────────────────────
# URL pública (sin barra final). En producción debe ser https://
# Franja de color y prefijo en el título para distinguir el entorno (no se define en producción).
APP_ENV="desarrollo"
APP_URL="http://localhost:3100"

# ─── Almacenamiento de fotos ─────────────────────────────────────
# "local" guarda en ./storage (solo desarrollo). "s3" usa Cloudflare R2 / S3.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# Para STORAGE_DRIVER="s3" (Cloudflare R2):
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="reportes-fotos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Datos semilla ───────────────────────────────────────────────
# Contraseña inicial del admin y técnicos de ejemplo (se exige cambiarla al entrar).
SEED_PASSWORD="Cambiar.2026"

# Solo desarrollo: IP de su PC para abrir la app desde el celular en la misma red Wi-Fi.
DEV_ALLOWED_ORIGINS=""
